<?xml version="1.0" encoding="utf-8"?>
<!--
    The full Material 3 colour role set is mapped here rather than a handful of
    tokens. Components read these roles directly, so mapping all of them is what
    makes every surface, container and outline follow the scheme automatically —
    including in dark mode, where values-night/colors.xml supplies the same names.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Connexa" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/connexa_primary</item>
        <item name="colorOnPrimary">@color/connexa_on_primary</item>
        <item name="colorPrimaryContainer">@color/connexa_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/connexa_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/connexa_inverse_primary</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/connexa_secondary</item>
        <item name="colorOnSecondary">@color/connexa_on_secondary</item>
        <item name="colorSecondaryContainer">@color/connexa_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/connexa_on_secondary_container</item>

        <!-- Tertiary: reserved for accents that must not read as a primary action -->
        <item name="colorTertiary">@color/connexa_tertiary</item>
        <item name="colorOnTertiary">@color/connexa_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/connexa_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/connexa_on_tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/connexa_error</item>
        <item name="colorOnError">@color/connexa_on_error</item>
        <item name="colorErrorContainer">@color/connexa_error_container</item>
        <item name="colorOnErrorContainer">@color/connexa_on_error_container</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/connexa_background</item>
        <item name="colorOnBackground">@color/connexa_on_background</item>
        <item name="colorSurface">@color/connexa_surface</item>
        <item name="colorOnSurface">@color/connexa_on_surface</item>
        <item name="colorSurfaceVariant">@color/connexa_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/connexa_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/connexa_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/connexa_inverse_on_surface</item>
        <item name="colorSurfaceContainerLowest">@color/connexa_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/connexa_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/connexa_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/connexa_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/connexa_surface_container_highest</item>

        <!-- Outlines -->
        <item name="colorOutline">@color/connexa_outline</item>
        <item name="colorOutlineVariant">@color/connexa_outline_variant</item>

        <!-- Matches the top app bar so the bar and the status area read as one
             surface. Going fully transparent without applying window insets makes
             the toolbar title collide with the clock. -->
        <item name="android:statusBarColor">@color/connexa_surface_container</item>
        <item name="android:navigationBarColor">@color/connexa_surface</item>

        <!-- System bar icons must invert with the scheme or they disappear into it. -->
        <item name="android:windowLightStatusBar">@bool/connexa_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">
            @bool/connexa_light_system_bars
        </item>

        <!-- Required before a shared element can cross between activities. Without it
             the transition is silently ignored rather than failing visibly. -->
        <item name="android:windowActivityTransitions">true</item>
        <!-- The rest of the page fades while the shared title travels, so the two screens
             read as one movement rather than a slide with something stuck on top. -->
        <item name="android:windowContentTransitions">true</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/Shape.Connexa.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.Connexa.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Connexa.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Connexa.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.Connexa.ExtraLarge</item>
    </style>

    <!--
        The launch screen.

        This is the system splash rather than an activity of our own. An extra
        activity would draw one more frame before the app appears, which makes
        startup measurably slower to reach the first useful screen — the opposite
        of what a launch screen is for. The system draws this the instant the icon
        is tapped, with no process of ours running yet.

        Because it is drawn before any code runs, everything here must be a
        literal: no theme attribute is resolvable this early.
    -->
    <style name="Theme.Connexa.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/connexa_icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <!-- Hands over to the app's own theme, so the first real frame is already
             correct rather than flashing the splash colours. -->
        <item name="postSplashScreenTheme">@style/Theme.Connexa</item>
    </style>

    <!--
        Type treatment.

        Material's default scale is correct about size and weight but leaves tracking
        at zero everywhere, which is what makes stock Android layouts read as
        unstyled. Two adjustments carry most of the difference:

          - large text is set tighter than default. Letterforms at headline size sit
            too far apart at zero tracking, and the eye reads the gaps rather than the
            word;
          - small labels are set looser and upper case. At label size the opposite is
            true: extra tracking is what stops capitals reading as a shout and makes
            them behave as a quiet editorial marker instead.

        Sizes are inherited from the Material scale rather than restated, so the
        accessibility text-size setting still applies.
    -->
    <style name="TextAppearance.Connexa.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Connexa.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.Connexa.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- The category marker on a card, and section headers. Upper case with wide
         tracking so it reads as a label rather than as a truncated sentence. -->
    <style name="TextAppearance.Connexa.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Toolbars are filled with colorPrimary, so their title, icons and overflow
         must resolve against colorOnPrimary. Resolving against the window's
         on-surface instead is what puts dark text on a dark bar. -->
    <style name="ThemeOverlay.Connexa.Toolbar" parent="">
        <item name="colorOnSurface">@color/connexa_on_primary</item>
        <item name="colorOnSurfaceVariant">@color/connexa_on_primary</item>
        <item name="android:textColorPrimary">@color/connexa_on_primary</item>
        <item name="android:textColorSecondary">@color/connexa_on_primary</item>
    </style>

    <style name="Shape.Connexa.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">4dp</item>
    </style>

    <style name="Shape.Connexa.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.Connexa.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Shape.Connexa.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Shape.Connexa.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Cards are outlined rather than filled, so a list of events reads as
         distinct items without stacking a shadow on every row. -->
    <style name="Widget.Connexa.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/connexa_outline_variant</item>
        <item name="cardBackgroundColor">@color/connexa_surface_container_low</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- 48dp is the minimum comfortable touch target; smaller controls are the
         most common accessibility failure in list-heavy screens. -->
    <style name="Widget.Connexa.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="Widget.Connexa.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="Widget.Connexa.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Full-width navigation row: left-aligned label with a leading icon, so a
         list of destinations scans vertically instead of reading as centred prose. -->
    <style name="Widget.Connexa.Destination" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">16dp</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
    </style>

    <style name="Widget.Connexa.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:minHeight">40dp</item>
    </style>

</resources>
