<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calendar_day_card"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/connexa_surface_container"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/calendar_day_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/connexa_on_surface" />

        <TextView
            android:id="@+id/calendar_day_marker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="7dp"
            android:layout_marginTop="1dp"
            android:text="&#x2022;"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/connexa_primary"
            android:visibility="invisible" />
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
