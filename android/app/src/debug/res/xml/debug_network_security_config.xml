<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. This file lives in the debug source set, so a release build never sees
  it and release traffic stays HTTPS-only.

  Cleartext is permitted to three hosts and no others:

    10.0.2.2    the emulator's alias for the host machine's loopback.
    localhost   a physical device paired over USB with `adb reverse tcp:8080 tcp:8080`,
    127.0.0.1   which forwards the device's own loopback to the laptop. This is preferred
                over a LAN address because it needs no Wi-Fi, survives changing networks,
                and exposes the API to nothing but the attached cable.

  To use a laptop's LAN address instead, add its IP as another <domain> below. Do not widen
  this to a base-config that permits cleartext everywhere: that would silently allow any
  plaintext endpoint a future change happens to point at.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
