# Connexa API local configuration template.
# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
#
# Every value here is intentionally empty. A template carries names only, so a
# placeholder can never be mistaken for a configured setting. Defaults that apply
# when a name is left unset are noted in the comments.

# =====================================================================
# TIER 1 - Identity  (unblocks RSVP, organizer drafts, publishing)
# =====================================================================
# firebase | rejecting   (default: rejecting - all protected routes return 401)
CONNEXA_IDENTITY_MODE=
CONNEXA_FIREBASE_PROJECT_ID=
# Path to the service-account JSON, e.g. ./private/service-account.connexa.json
CONNEXA_FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated emails granted the ORGANIZER role. The address is read from the
# verified token, never from a client-supplied header.
CONNEXA_ORGANIZER_EMAILS=
# Anyone can register any address with email/password sign-in, so an unverified
# address must not satisfy the allowlist. (default: true)
CONNEXA_ORGANIZER_REQUIRE_VERIFIED_EMAIL=
# Rejects tokens revoked by logout or account disable, at the cost of one extra
# provider lookup per request. (default: true)
CONNEXA_IDENTITY_CHECK_REVOKED=

# =====================================================================
# TIER 2 - Durable persistence
# =====================================================================
# postgres | in-memory   (default: in-memory - nothing survives a restart)
CONNEXA_PERSISTENCE_MODE=
# Managed providers require TLS: append ?sslmode=require to the URL.
CONNEXA_DB_URL=
CONNEXA_DB_USERNAME=
CONNEXA_DB_PASSWORD=
# Run migrations on startup. (default: false)
CONNEXA_DB_MIGRATE=
# Include the database in the health probe. (default: false)
CONNEXA_DB_HEALTH=
# (default: 10)
CONNEXA_DB_POOL_MAX=

# =====================================================================
# TIER 3 - Assistant
# =====================================================================
# gemini | disabled   (default: disabled)
CONNEXA_ASSISTANT_MODE=
CONNEXA_AI_PROVIDER=
CONNEXA_AI_MODEL=
CONNEXA_AI_API_KEY=
# (default: 20)
CONNEXA_AI_MAX_REQUESTS_PER_MINUTE=
# (default: 1024)
CONNEXA_AI_MAX_OUTPUT_TOKENS=

# =====================================================================
# TIER 4 - Announcement ingestion
# =====================================================================
# Shared token for the announcement reader. Intake stays closed while unset.
CONNEXA_INGESTION_API_TOKEN=
# Attribution used when an announcement names no organiser.
# (default: Campus Announcements)
CONNEXA_INGESTION_ORGANIZER_NAME=
CONNEXA_ANNOUNCEMENT_MAILBOX=
CONNEXA_MAIL_USERNAME=
# A dedicated app password only. Never a primary account password.
CONNEXA_MAIL_PASSWORD=
# (defaults: imap.gmail.com / 993 / ssl / INBOX)
CONNEXA_MAIL_HOST=
CONNEXA_MAIL_PORT=
CONNEXA_MAIL_TLS=
CONNEXA_MAIL_FOLDER=
# Sender allowlist. Domains and exact addresses are separate settings; both empty
# means nothing is ingested, which is the safe default.
CONNEXA_INGESTION_ALLOWED_DOMAINS=
CONNEXA_INGESTION_ALLOWED_SENDERS=
# (default: 7200)
CONNEXA_INGESTION_POLL_INTERVAL_SECONDS=

# =====================================================================
# TIER 5 - Organizer media storage
# =====================================================================
# cloudinary | firebase | disabled   (default: disabled)
CONNEXA_STORAGE_MODE=
CONNEXA_STORAGE_BUCKET=
# (defaults: 5242880 bytes; image/jpeg,image/png,image/webp)
CONNEXA_STORAGE_MAX_BYTES=
CONNEXA_STORAGE_ALLOWED_TYPES=
# Cloudinary. The API secret signs uploads on the server and is never sent to the
# Android app: the app asks the API for a short-lived signature and uploads with that.
CONNEXA_CLOUDINARY_CLOUD_NAME=
CONNEXA_CLOUDINARY_API_KEY=
CONNEXA_CLOUDINARY_API_SECRET=
# Folder all Connexa uploads land in. (default: connexa/events)
CONNEXA_CLOUDINARY_FOLDER=

# =====================================================================
# TIER 6 - Deployment
# =====================================================================
# (default: local)
CONNEXA_ENVIRONMENT=
CONNEXA_APP_VERSION=
CONNEXA_CORS_ALLOWED_ORIGINS=
